# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=http://localhost:3000

# API 호출 URL은 config.py 기본값 사용 (변경 필요 시 config.py 수정)

# 1. 지역 상권 분석
SANGKWON_API_KEY=
SEOUL_SALES_API_KEY=
KAKAO_REST_API_KEY=

# 2. 경기지표·소비트렌드 분석
ECOS_API_KEY=
KOSIS_API_KEY=
KOSIS_CONSUMPTION_ITM_ID=
KOSIS_CONSUMPTION_OBJ_ID=

# 3. 정책자금·금융상품 분석
BIZINFO_API_KEY=
FINLIFE_API_KEY=

# 4. 위기진단 (국토교통부 주요상권 — VWorld 2D Data API)
# 발급: https://www.vworld.kr → 오픈API → 인증키 발급
# 활용 API: 2D데이터 API 체크 / domain은 발급 시 등록한 URL과 동일하게
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
